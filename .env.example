# Copy this file to ".env" and keep ".env" private (never upload it to GitHub).

# Option A: MongoDB installed on your own computer (default port)
MONGODB_URI=

# Option B: MongoDB Atlas (cloud). Replace the placeholders with your own values:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/?retryWrites=true&w=majority

# A long random text used to keep logins secure. Change it to anything you like.
SECRET_KEY=change-this-to-a-long-random-text

# Secret code that teachers type on the Sign up page to create a teacher account.
# Give it only to real teachers. Change it to your own secret.
TEACHER_CODE=teacher-secret-2026
